  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "start": "next start",
    "lint": "next lint",
    "typegen": "next typegen .",
    "postinstall": "fumadocs-mdx",
    "build:registry:internal": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/build-registry.mts",
    "build:registry:external": "shadcn build ./src/__registry__/registry.autogenerated.json",
    "build:registry": "npm run build:registry:internal && npm run build:registry:external",
    "build:docs": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@samvera/clover-iiif": "3.6.0",
    "@tailwindcss/typography": "0.5.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.8.5",
    "glob": "13.0.6",
    "jotai": "2.19.1",
    "lucide-react": "1.14.0",
    "motion": "12.38.0",
    "next": "16.2.4",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-resizable-panels": "4.10.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.2.4",
    "@types/mdx": "2.0.13",
    "@types/node": "22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "colorjs.io": "0.6.1",
    "esbuild": "0.28.0",
    "eslint": "9",
    "eslint-config-next": "16.2.4",
    "shadcn": "4.6.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5"
  }
}