    "@thegetty/linkedart.js": "0.20.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.6.1",
    "edtf": "4.12.0",
